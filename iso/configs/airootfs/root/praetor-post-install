#!/usr/bin/env bash
# Runs on the live ISO after omarchy's install.sh finished in the chroot and
# before reboot. $1 = target username. Offline: no network here.
set -euo pipefail
user="$1"; home="/mnt/home/$user"
echo "praetor: post-install for $user"
cp -r /root/praetor "$home/.local/share/praetor"
[[ -d /root/praetor-private ]] && cp -r /root/praetor-private "$home/.local/share/praetor-private"
arch-chroot /mnt chown -R "$user:$user" "/home/$user/.local/share"
arch-chroot -u "$user" /mnt env PRAETOR_CHROOT_INSTALL=1 HOME="/home/$user" \
  bash -lc "bash /home/$user/.local/share/praetor/install/all.sh"
arch-chroot /mnt env PRAETOR_CHROOT_INSTALL=1 PRAETOR_USER="$user" \
  bash -c "bash /home/$user/.local/share/praetor/install/root.sh"
echo "praetor: post-install done"
