# Praetor core — installed on top of Omarchy's base list.
# Praetor also REMOVES the packages listed in remove.packages.
# One package per line; comments and blank lines ignored.

# theme backgrounds ship as SVG and are rasterised at install time
librsvg

# browser / media
firefox
# terminal flair (opt-in toys, installed but not default)
cava
cmatrix
cool-retro-term
# remote access
tailscale
wayvnc
# computer use: cua-driver installed by overlay/install via `hermes computer-use install`
# voice pipeline runtime (Python bits come via uv into /opt/praetor/voice)
python
python-pip
portaudio
pipewire-pulse
# piper-tts is AUR-only; the voice stack is installed at first boot (milestone 3)
# toolchains
go
bun
uv
# agents (hermes-agent and codex installed by overlay/install scripts)
claude-code
