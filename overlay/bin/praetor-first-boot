#!/usr/bin/env bash
# User half of first boot: network-dependent setup that may need to prompt.
# Launched in a terminal by the post-boot hook, and safe to re-run by hand.
set -uo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/share/praetor/bin:$PATH"
state="$HOME/.local/state/praetor"; mkdir -p "$state"
log="$state/first-boot.log"
exec > >(tee -a "$log") 2>&1
echo "== praetor first boot $(date -Is) =="

for _ in $(seq 1 60); do curl -fsI https://archlinux.org >/dev/null 2>&1 && break; sleep 2; done

# Tailscale and Hermes are the root unit's job; report, do not duplicate.
if [[ "$(praetor-config network.tailscale 2>/dev/null)" == "true" ]]; then
  tailscale status >/dev/null 2>&1 \
    || echo "tailscale not up — see /var/lib/praetor/first-boot-root.log, then: sudo tailscale up --ssh"
fi
command -v hermes >/dev/null || echo "hermes not installed — see /var/lib/praetor/first-boot-root.log"

# Codex CLI via mise-managed node
if ! command -v codex >/dev/null || [[ -L "$(command -v codex)" ]]; then
  mise use -g node@24 >/dev/null 2>&1 || true
  mise exec -- npm install -g @openai/codex || true
fi

# Antigravity (AUR). yay needs sudo for the pacman step; this runs in a terminal.
if [[ "$(praetor-config agents.antigravity 2>/dev/null)" == "true" ]] && ! command -v antigravity >/dev/null; then
  yay -S --noconfirm --needed antigravity-bin || yay -S --noconfirm --needed antigravity || true
fi

# wayvnc on the Tailscale address only
if [[ "$(praetor-config remote.wayvnc 2>/dev/null)" == "true" ]]; then
  mkdir -p "$HOME/.config/wayvnc" "$HOME/.config/systemd/user"
  ip="$(tailscale ip -4 2>/dev/null | head -1)"
  printf 'address=%s\nenable_auth=false\n' "${ip:-127.0.0.1}" > "$HOME/.config/wayvnc/config"
  printf '[Unit]\nDescription=wayvnc (Tailscale only)\nAfter=graphical-session.target\n[Service]\nExecStart=/usr/bin/wayvnc\nRestart=on-failure\n[Install]\nWantedBy=graphical-session.target\n' \
    > "$HOME/.config/systemd/user/wayvnc.service"
  systemctl --user daemon-reload
  systemctl --user enable --now wayvnc.service || true
fi

touch "$state/first-boot.done"
notify-send "Praetor" "First-boot setup finished." 2>/dev/null || true
echo "== done $(date -Is) =="
