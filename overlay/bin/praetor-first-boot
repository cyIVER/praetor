#!/usr/bin/env bash
# User half of first boot: network-dependent setup that may need to prompt.
# Launched in a terminal by the post-boot hook, and safe to re-run by hand.
set -uo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/share/praetor/bin:$PATH"
state="$HOME/.local/state/praetor"; mkdir -p "$state"
log="$state/first-boot.log"
exec > >(tee -a "$log") 2>&1
echo "== praetor first boot $(date -Is) =="

for _ in $(seq 1 60); do curl -fsI https://archlinux.org >/dev/null 2>&1 && break; sleep 2; done

# Tailscale and Hermes are the root unit's job; report, do not duplicate.
if [[ "$(praetor-config network.tailscale 2>/dev/null)" == "true" ]]; then
  tailscale status >/dev/null 2>&1 \
    || echo "tailscale not up — see /var/lib/praetor/first-boot-root.log, then: sudo tailscale up --ssh"
fi
command -v hermes >/dev/null || echo "hermes not installed — see /var/lib/praetor/first-boot-root.log"

# Codex CLI via mise-managed node
if ! command -v codex >/dev/null || [[ -L "$(command -v codex)" ]]; then
  mise use -g node@24 >/dev/null 2>&1 || true
  mise exec -- npm install -g @openai/codex || true
fi

# Antigravity (AUR). yay needs sudo for the pacman step; this runs in a terminal.
if [[ "$(praetor-config agents.antigravity 2>/dev/null)" == "true" ]] && ! command -v antigravity >/dev/null; then
  yay -S --noconfirm --needed antigravity-bin || yay -S --noconfirm --needed antigravity || true
fi

# wayvnc on the Tailscale address only
if [[ "$(praetor-config remote.wayvnc 2>/dev/null)" == "true" ]]; then
  mkdir -p "$HOME/.config/wayvnc" "$HOME/.config/systemd/user"
  ip="$(tailscale ip -4 2>/dev/null | head -1)"
  printf 'address=%s\nenable_auth=false\n' "${ip:-127.0.0.1}" > "$HOME/.config/wayvnc/config"
  printf '[Unit]\nDescription=wayvnc (Tailscale only)\nAfter=graphical-session.target\n[Service]\nExecStart=/usr/bin/wayvnc --render-cursor\nRestart=on-failure\n[Install]\nWantedBy=graphical-session.target\n' \
    > "$HOME/.config/systemd/user/wayvnc.service"
  systemctl --user daemon-reload
  systemctl --user enable --now wayvnc.service || true
fi

# Sunshine (Moonlight host) on the Tailscale address only. Learned 2026-09-11:
# wlroots screencopy capture fails to import frames on Hyprland+Intel (EGL bad match);
# KMS capture works with the VAAPI encoders. The web UI rejects non-localhost origins
# unless listed, and Tailscale addresses do not count as LAN.
if [[ "$(praetor-config remote.sunshine 2>/dev/null)" == "true" ]]; then
  command -v sunshine >/dev/null || yay -S --noconfirm --needed sunshine-bin || true
  if command -v sunshine >/dev/null; then
    mkdir -p "$HOME/.config/sunshine" "$HOME/.config/systemd/user"
    ts_ip="$(tailscale ip -4 2>/dev/null | head -1)"
    ts_name="$(tailscale status --self --json 2>/dev/null | python3 -c 'import sys,json; d=json.load(sys.stdin)["Self"]; print(d.get("DNSName","").rstrip("."))' 2>/dev/null || true)"
    short="${ts_name%%.*}"
    origins="https://localhost:47990"
    [[ -n "$short" ]]   && origins="$origins,https://$short:47990"
    [[ -n "$ts_name" ]] && origins="$origins,https://$ts_name:47990"
    [[ -n "$ts_ip" ]]   && origins="$origins,https://$ts_ip:47990"
    cfg="$HOME/.config/sunshine/sunshine.conf"; touch "$cfg"
    sed -i '/^csrf_allowed_origins/d; /^origin_web_ui_allowed/d; /^capture/d' "$cfg"
    printf 'csrf_allowed_origins = %s\norigin_web_ui_allowed = wan\ncapture = kms\n' "$origins" >> "$cfg"
    printf '[Unit]\nDescription=Sunshine self-hosted game stream host\nAfter=graphical-session.target\nPartOf=graphical-session.target\n[Service]\nExecStart=/usr/bin/sunshine\nRestart=on-failure\nRestartSec=5s\n[Install]\nWantedBy=graphical-session.target\n' \
      > "$HOME/.config/systemd/user/sunshine.service"
    systemctl --user daemon-reload; systemctl --user enable --now sunshine.service || true
    sudo ufw allow in on tailscale0 comment tailnet >/dev/null 2>&1 || true
  fi
fi

touch "$state/first-boot.done"
notify-send "Praetor" "First-boot setup finished." 2>/dev/null || true
echo "== done $(date -Is) =="
